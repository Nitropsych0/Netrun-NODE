# NETRUN per-GB haproxy — written by node_agent/pergb_runtime.js (POST /pergb/enable, agent start); do not edit.
# Shared ports 31000-31999 on 203.0.113.10: TLS -> 3proxy-pergb proxy 127.0.0.3:<port>,
# SOCKS5 -> 3proxy-pergb socks 127.0.0.4:<port>, a plain HTTP-proxy request -> 127.0.0.3:<port>
# as well (same auth, log and meter; not advertised), anything else rejected.
global
    log /dev/log local1 info
    log-tag netrun-pergb-haproxy
    maxconn 17000
    nbthread 2
    ssl-default-bind-options ssl-min-ver TLSv1.2
    stats socket /run/netrun-pergb/haproxy.sock mode 600 level admin
    user haproxy
    group haproxy

defaults
    mode tcp
    log global
    option dontlognull
    maxconn 17000
    timeout connect 10s
    timeout client 1h
    timeout server 1h
    timeout tunnel 1h
    log-format "%ci:%cp %fp %bi:%bp %Tt %B %U"

frontend pergb_in
    bind 203.0.113.10:31000-31999
    tcp-request inspect-delay 5s
    acl plain_http req.payload(0,4) -m bin 47455420 50555420
    acl plain_http req.payload(0,5) -m bin 4845414420 504f535420
    acl plain_http req.payload(0,6) -m bin 504154434820 545241434520
    acl plain_http req.payload(0,7) -m bin 44454c45544520
    acl plain_http req.payload(0,8) -m bin 4f5054494f4e5320 434f4e4e45435420
    tcp-request content accept if { req.ssl_hello_type 1 }
    tcp-request content accept if { req.len gt 0 } { req.payload(0,1) -m bin 05 }
    tcp-request content accept if plain_http
    tcp-request content reject
    use_backend pergb_tls_loop if { req.ssl_hello_type 1 }
    use_backend pergb_http if plain_http
    default_backend pergb_socks

backend pergb_socks
    balance leastconn
    server socks1 127.0.0.4 source 127.0.2.1
    server socks2 127.0.0.4 source 127.0.2.2
    server socks3 127.0.0.4 source 127.0.2.3
    server socks4 127.0.0.4 source 127.0.2.4
    server socks5 127.0.0.4 source 127.0.2.5
    server socks6 127.0.0.4 source 127.0.2.6
    server socks7 127.0.0.4 source 127.0.2.7
    server socks8 127.0.0.4 source 127.0.2.8

backend pergb_tls_loop
    server tls abns@netrun_pergb_tls send-proxy-v2

frontend pergb_tls
    bind abns@netrun_pergb_tls accept-proxy ssl crt-list /etc/netrun/tls/crt-list alpn http/1.1
    default_backend pergb_http

backend pergb_http
    balance leastconn
    server http1 127.0.0.3 source 127.0.1.1
    server http2 127.0.0.3 source 127.0.1.2
    server http3 127.0.0.3 source 127.0.1.3
    server http4 127.0.0.3 source 127.0.1.4
    server http5 127.0.0.3 source 127.0.1.5
    server http6 127.0.0.3 source 127.0.1.6
    server http7 127.0.0.3 source 127.0.1.7
    server http8 127.0.0.3 source 127.0.1.8
