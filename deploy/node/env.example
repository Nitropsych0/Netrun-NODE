NODE_AGENT_HOST=0.0.0.0
NODE_AGENT_PORT=8085
NODE_AGENT_PROXY_ROOT=/opt/netrun/proxyserver
NODE_AGENT_JOBS_ROOT=/opt/netrun/jobs
# NODE_AGENT_API_KEY=
# NODE_AGENT_DEFAULT_TIMEOUT_SEC=900
# IPv6 egress rotation (node_agent/egress.js) — defaults shown. Rotated / pool
# addresses are proxy-NDP entries (`ip -6 neigh show proxy dev <if>`), never NIC
# addresses: at start the agent sets all/<if>.proxy_ndp=1, <if>.proxy_delay=0,
# all/<if>.forwarding=1 (only what differs) and keeps them in EGRESS_SYSCTL_CONF;
# its nft table drops forwarded packets to the node's /64 (README, "Proxy NDP").
# EGRESS_DRAIN_SEC=600
# EGRESS_POOL_SIZE=1024
# EGRESS_POOL_REFRESH_SEC=600
# EGRESS_POOL_REFRESH_FRACTION=0.25
# EGRESS_MAX_EXTRA_ADDRS=40000
# NODE_EGRESS_PREFIX=2001:db8:1:2::/64
# EGRESS_NFT_DROPIN=/etc/systemd/system/nftables.service.d/netrun-egress.conf   # off = do not write
# EGRESS_SYSCTL_CONF=/etc/sysctl.d/99-netrun-egress.conf   # off = do not write
# Exit guard (audit FP-01): the same table's input chain drops unsolicited inbound
# traffic (SYN to any port incl. sshd :22, UDP, ping) to every exit IPv6 of the /64,
# like a home router — anti-fraud port scans see a filtered host, not a server. The
# node's own non-/128 address (and IPv4) stays reachable; replies to connections the
# node opened pass (README, "Exit guard").
# EGRESS_EXIT_GUARD=on                     # off = no exit guard (applied at the next agent start)
# Wave FLEET-HEALTH — defaults shown
# NODE_AGENT_JOBS_KEEP=200                 # job dirs kept in NODE_AGENT_JOBS_ROOT (0 = never prune)
# NODE_AGENT_REBIND_POLICY=kill            # callers without reclaimStartPorts: kill | refuse
# NODE_AGENT_NFT_DUMP_TIMEOUT_MS=20000     # nft counter dump timeout for /accounting; the orchestrator's
#                                         # TRAFFIC_POLL_REQUEST_TIMEOUT_SEC must stay ABOVE it (/1000 + parse), e.g. 30
# NODE_AGENT_IPV6_COVERAGE_TTL_SEC=60      # /health ipv6Addresses recompute period
# Incident 2026-10-07 (every batch ran twice after a reboot) — defaults shown (README, "Boot duplicates")
# NODE_AGENT_DEDUPE_3PROXY=1               # 0 = never kill a duplicate 3proxy (same cfg twice)
# NODE_AGENT_CRON_HYGIENE=1                # 0 = keep generator proxy-startup_*.sh crontab lines; force = remove
#                                         # them even when netrun-3proxy-restore / netrun-ipv6-restore are not enabled
# NODE_AGENT_HYGIENE_INTERVAL_SEC=600      # crontab sweep + duplicate reaper period (min 60)
# NETRUN_ACCOUNTING_MATCH_IPV4 — do NOT set it here: put NETRUN_ACCOUNTING_MATCH_IPV4=1 in
# /etc/netrun/netrun.env, which the generator AND the netrun-https sync timer both read
# (set only in this unit, the 5-min sync would converge the rule back to port-only).
# Audit N2 (README, "3proxy supervision, desired-state firewall, node source address") — defaults shown
# NODE_AGENT_SUPERVISOR=1                  # 0 = no dead-batch respawn / anchor re-add / anchor deprecation
# NODE_AGENT_SUPERVISOR_INTERVAL_SEC=60    # min 15
# NODE_AGENT_SUPERVISOR_FIRST_DELAY_SEC=120
# NODE_AGENT_SUPERVISOR_MAX_RESPAWNS_PER_HOUR=5   # per cfg; then "failed" until it listens or its cfg changes
# NODE_AGENT_SUPERVISOR_SETTLE_SEC=120     # a cfg written this recently is never respawned
# NODE_AGENT_SUPERVISOR_STATUS_FILE=/run/netrun/supervisor.json
# NODE_AGENT_ANCHOR_READD_BATCH=2000       # missing anchors re-added per tick (~30 ms of RTNL each at 16k)
# NODE_AGENT_ANCHOR_DEPRECATE_BATCH=2000   # anchors deprecated per tick
# NETRUN_3PROXY_SPAWN=/opt/netrun/scripts/netrun-3proxy-spawn.sh   # off = direct detached start
# NODE_AGENT_FIREWALL_DESIRED=1            # 0 = no POST /firewall/desired, no re-apply, no lift on /generate
# NODE_AGENT_FIREWALL_STATE_FILE=/var/lib/netrun/desired.json
# NODE_AGENT_FIREWALL_REAPPLY_SEC=900
# NODE_AGENT_FIREWALL_FRESH_SEC=1800       # listeners of a cfg written this recently are never ghosts
# NODE_AGENT_FIREWALL_MAX_NEW_BLOCKS=3000  # a push adding more is refused (409) unless force
# Node-wide switches — put them in /etc/netrun/netrun.env (read by the agent, the generator and
# the boot scripts; the environment wins):
#   NETRUN_ANCHOR_DEPRECATE=1   # 0 = anchors stay preferred (node traffic may leave from a customer IP)
#   NETRUN_ANCHOR_READD=1       # 0 = the supervisor never re-adds missing anchors
#   NETRUN_3PROXY_MAXCONN=512   # new batches' maxconn (listen backlog = maxconn/16 + 1); 200 = old value
#   NETRUN_SPAWN_FIX_DNS=1      # (environment of the spawn helper) 0 = keep legacy third-party nserver lines
