@@ -443,11 +455,56 @@
 			param->sinsl = param->srv->extsa;
 	}
 	*SAPORT(&param->sinsl) = 0;
+#ifdef __linux__
+#ifndef IP_BIND_ADDRESS_NO_PORT
+#define IP_BIND_ADDRESS_NO_PORT 24
+#endif
+	/* netrun-pergb: defer the source port to connect(), so sockets bound to
+	   one source address but connecting to different destinations share
+	   source ports (no ephemeral port exhaustion of the egress IPv4). */
+	if(param->operation >= 256 || (param->operation & CONNECT)){
+		int opt = 1;
+		so._setsockopt(param->remsock, IPPROTO_IP, IP_BIND_ADDRESS_NO_PORT, (char *)&opt, sizeof(opt));
+	}
+#endif
 	if(so._bind(param->remsock, (struct sockaddr*)&param->sinsl, SASIZE(&param->sinsl))==-1) {
 		return 12;
 	}
 	
 	if(param->operation >= 256 || (param->operation & CONNECT)){
+		/* netrun-pergb #4: per-client OS fingerprint from the login's
+		   -os-<profile>. Windows advertises hop limit 128 (the main p0f
+		   tell); macOS and Linux keep 64, so only Windows is rewritten
+		   here. Set on the outbound socket before connect so the SYN
+		   carries it; no privilege needed. The TCP window / scale / option
+		   part of the fingerprint is done by the tc-bpf egress program. */
+		if(param->username){
+			/* netrun-pergb #4 v2: per-client OS fingerprint. Mark the
+			   outbound socket with FNV-1a(name) from the login's
+			   -os-<name>; the egress helper (deploy/node/osfp) maps the
+			   mark to a p0f signature and rewrites the SYN (ttl, window,
+			   scale, options). SO_MARK needs CAP_NET_ADMIN; without it the
+			   setsockopt fails harmlessly (no spoof). Must match the FNV in
+			   osfp_rewrite.py / the orchestrator byte for byte. */
+			char *osn = strstr((char *)param->username, "-os-");
+			if(osn){
+				unsigned int h = 2166136261u;
+				int n = 0;
+				osn += 4;
+				while(osn[n] && osn[n] != '-' && n < 32){
+					unsigned char c = (unsigned char)osn[n];
+					if(c >= 'A' && c <= 'Z') c = (unsigned char)(c + 32);
+					h = (h ^ c) * 16777619u;
+					n++;
+				}
+				if(n > 0){
+					int mark = (int)(0x10000000u | (h & 0x0FFFFFFFu));
+#ifdef SO_MARK
+					so._setsockopt(param->remsock, SOL_SOCKET, SO_MARK, (char *)&mark, sizeof(mark));
+#endif
+				}
+			}
+		}
 		if(connectwithpoll(param->remsock,(struct sockaddr *)&param->sinsr,SASIZE(&param->sinsr),CONNECT_TO)) {
 			return 13;
 		}
