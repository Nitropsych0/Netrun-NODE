NETRUN per-GB 3proxy: 3proxy 0.9.3 (upstream tag 0.9.3) + two changes.
Applied with `patch -p1` in the extracted 3proxy-0.9.3/ tree by
scripts/build_3proxy_pergb.sh; the result is deploy/node/bin/3proxy-pergb
(sha256 pinned in deploy/node/bin/3proxy-pergb.sha256). Per-piece batches keep
the stock deploy/node/bin/3proxy.

1. conf.c h_authcache: `authcache none` sets authcachetype 0. doauth()
   (auth.c) inserts a cache entry after every successful auth whenever the type
   is non-zero and never prunes it (only cacheauth() prunes, and it runs only
   with `auth cache`): one leaked entry per distinct login with the default
   type 6, one per connection with `acl`, each insert a walk of the whole list
   under the global hash mutex. Upstream turns 0 into 6, so the cache could not
   be switched off from the cfg.
2. common.c (outbound connect): IP_BIND_ADDRESS_NO_PORT before the bind of the
   outbound socket, so the source port is chosen at connect() for the full
   4-tuple: sockets from one egress address to different destinations share
   source ports instead of each holding one of ip_local_port_range.
3. socks.c (SOCKS listener): consume an optional HAProxy PROXY v2 header at the
   start of sockschild and set sincr = the real client, sincl = the public
   address the client dialed. The per-GB haproxy sends send-proxy-v2 on the
   pergb_socks backend (loopback-only, trusted). The existing SOCKS5 UDP
   ASSOCIATE relay then advertises the PUBLIC sincl (not the 127.0.0.4 the
   listener binds) and validates incoming datagrams against the REAL client
   sincr (not haproxy's loopback hop source) -- so UDP works on the same
   ports, natively, with the same domain/login. A SOCKS greeting (first byte
   5/4) never matches the magic (0x0D), so a connection without the header is
   untouched.

diff -ru a/src/common.c b/src/common.c
--- a/src/common.c
+++ b/src/common.c
@@ -443,6 +443,18 @@
 			param->sinsl = param->srv->extsa;
 	}
 	*SAPORT(&param->sinsl) = 0;
+#ifdef __linux__
+#ifndef IP_BIND_ADDRESS_NO_PORT
+#define IP_BIND_ADDRESS_NO_PORT 24
+#endif
+	/* netrun-pergb: defer the source port to connect(), so sockets bound to
+	   one source address but connecting to different destinations share
+	   source ports (no ephemeral port exhaustion of the egress IPv4). */
+	if(param->operation >= 256 || (param->operation & CONNECT)){
+		int opt = 1;
+		so._setsockopt(param->remsock, IPPROTO_IP, IP_BIND_ADDRESS_NO_PORT, (char *)&opt, sizeof(opt));
+	}
+#endif
 	if(so._bind(param->remsock, (struct sockaddr*)&param->sinsl, SASIZE(&param->sinsl))==-1) {
 		return 12;
 	}
diff -ru a/src/conf.c b/src/conf.c
--- a/src/conf.c
+++ b/src/conf.c
@@ -1356,6 +1356,10 @@
 #endif
 static int h_authcache(int argc, unsigned char **argv){
 	conf.authcachetype = 0;
+	/* netrun-pergb: `authcache none` switches the cache off (type 0), so
+	   doauth() never inserts an entry. Upstream turns 0 into 6 below, and
+	   every type leaks one entry per distinct login (or per connection). */
+	if(!strcmp((char *) *(argv + 1), "none")) return 0;
 	if(strstr((char *) *(argv + 1), "ip")) conf.authcachetype |= 1;
 	if(strstr((char *) *(argv + 1), "user")) conf.authcachetype |= 2;
 	if(strstr((char *) *(argv + 1), "pass")) conf.authcachetype |= 4;
diff -ru a/src/socks.c b/src/socks.c
--- a/src/socks.c
+++ b/src/socks.c
@@ -40,6 +40,66 @@
 
  if(!(buf = myalloc(BUFSIZE))) {RETURN(21);}
  memset(buf, 0, BUFSIZE);
+ /* netrun-pergb: consume an optional HAProxy PROXY v2 header (send-proxy-v2
+    on the pergb_socks backend; loopback-only listener, so it is trusted) and
+    set sincr = the real client and sincl = the public address the client
+    dialed. The SOCKS5 UDP ASSOCIATE relay (command 3 below) then advertises
+    that public sincl and checks datagrams against the real sincr, so UDP
+    works on the same ports without any extra client setup. A SOCKS greeting
+    (first byte 5/4) never equals the magic (0x0D), so a header-less
+    connection is left byte-for-byte untouched. */
+#ifndef MSG_PEEK
+#define MSG_PEEK 2
+#endif
+ {
+	static const unsigned char pp2sig[12] =
+		{0x0D,0x0A,0x0D,0x0A,0x00,0x0D,0x0A,0x51,0x55,0x49,0x54,0x0A};
+	unsigned char pp[16];
+	struct pollfd ppfd;
+	int ppg = 0, pptries;
+	ppfd.fd = param->clisock; ppfd.events = POLLIN;
+	for(pptries = 0; pptries < 8; pptries++){
+		if(so._poll(&ppfd, 1, conf.timeouts[SINGLEBYTE_L]*1000) <= 0){ppg = 0; break;}
+		ppg = (int)so._recv(param->clisock, (void *)pp, 16, MSG_PEEK);
+		if(ppg <= 0){ppg = 0; break;}
+		if(memcmp(pp, pp2sig, (ppg < 12) ? ppg : 12)){ppg = 0; break;}
+		if(ppg >= 16) break;
+	}
+	if(ppg >= 16 && (pp[12] & 0xf0) == 0x20){
+		int ppalen = (pp[14] << 8) | pp[15];
+		int ppcmd = pp[12] & 0x0f;
+		int ppfam = pp[13];
+		int pptot = 16 + ppalen, ppoff = 0, ppr;
+		if(pptot >= 16 && pptot <= (int)BUFSIZE){
+			while(ppoff < pptot){
+				ppr = (int)so._recv(param->clisock, (void *)(buf + ppoff), pptot - ppoff, 0);
+				if(ppr <= 0) break;
+				ppoff += ppr;
+			}
+			if(ppoff == pptot && ppcmd == 1){
+				unsigned char *ppa = buf + 16;
+				if(ppfam == 0x11 && ppalen >= 12){
+					*SAFAMILY(&param->sincr) = AF_INET;
+					memcpy(SAADDR(&param->sincr), ppa, 4);
+					memcpy(SAPORT(&param->sincr), ppa + 8, 2);
+					*SAFAMILY(&param->sincl) = AF_INET;
+					memcpy(SAADDR(&param->sincl), ppa + 4, 4);
+					memcpy(SAPORT(&param->sincl), ppa + 10, 2);
+				}
+#ifndef NOIPV6
+				else if(ppfam == 0x21 && ppalen >= 36){
+					*SAFAMILY(&param->sincr) = AF_INET6;
+					memcpy(SAADDR(&param->sincr), ppa, 16);
+					memcpy(SAPORT(&param->sincr), ppa + 32, 2);
+					*SAFAMILY(&param->sincl) = AF_INET6;
+					memcpy(SAADDR(&param->sincl), ppa + 16, 16);
+					memcpy(SAPORT(&param->sincl), ppa + 34, 2);
+				}
+#endif
+			}
+		}
+	}
+ }
  if ((ver = sockgetcharcli(param, conf.timeouts[SINGLEBYTE_L], 0)) != 5 && ver != 4) {
 	RETURN(401);
  } /* version */
