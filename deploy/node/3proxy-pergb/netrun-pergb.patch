NETRUN per-GB 3proxy: 3proxy 0.9.3 (upstream tag 0.9.3) + five changes.
Applied with `patch -p1` in the extracted 3proxy-0.9.3/ tree by
scripts/build_3proxy_pergb.sh; the result is deploy/node/bin/3proxy-pergb
(sha256 pinned in deploy/node/bin/3proxy-pergb.sha256). Per-piece batches keep
the stock deploy/node/bin/3proxy.

1. conf.c h_authcache: `authcache none` sets authcachetype 0. doauth()
   (auth.c) inserts a cache entry after every successful auth whenever the type
   is non-zero and never prunes it (only cacheauth() prunes, and it runs only
   with `auth cache`): one leaked entry per distinct login with the default
   type 6, one per connection with `acl`, each insert a walk of the whole list
   under the global hash mutex. Upstream turns 0 into 6, so the cache could not
   be switched off from the cfg.
2. common.c (connectwithpoll): after poll() reports the non-blocking connect
   finished, check SO_ERROR before declaring success. poll() returns the socket
   writable on a FAILED connect too (POLLOUT|POLLERR for an RST or an
   unreachable host), so stock 3proxy answers "200 Connection established" (and
   a SOCKS success) for a dead upstream, then the relay closes at once — a
   client sees a TLS error instead of an honest 502/SOCKS reject, and proxy
   checkers read the dead tunnel as alive. A non-zero SO_ERROR now fails the
   connect (code 13 -> 502 / SOCKS reply 5).
3. common.c (outbound connect): IP_BIND_ADDRESS_NO_PORT before the bind of the
   outbound socket, so the source port is chosen at connect() for the full
   4-tuple: sockets from one egress address to different destinations share
   source ports instead of each holding one of ip_local_port_range.
4. common.c (doconnect, #4 OS fingerprint): from the login's -os-<profile>, set
   the outbound hop limit (128 for windows, 64 for macos — IP_TTL /
   IPV6_UNICAST_HOPS, no privilege) and SO_MARK (1 windows, 2 macos) for the
   egress fingerprint rewriter (deploy/node/osfp); SO_MARK needs CAP_NET_ADMIN
   and fails harmlessly without it (only the TTL applies). The window / scale /
   option / timestamp rewrite is done by that rewriter, not in 3proxy.
5. socks.c (the SOCKS reply code): upstream maps a result >= 100 to
   res % 10, so res 100 — no destination, the name did not resolve (every
   IPv4-only site once the node is -6, IPv6 only since 2026-10-14) — became
   reply 0 = success: the client read "request granted" and got an empty
   tunnel. 100 now answers 4 (host unreachable), any other res % 10 == 0
   answers 1 (general failure). SOCKS4 follows (91 rejected).

diff -ru a/src/common.c b/src/common.c
--- a/src/common.c
+++ b/src/common.c
@@ -382,6 +382,18 @@
 	        fds[0].events = POLLOUT;
 		if(so._poll(fds, 1, to*1000) <= 0) {
 			return (13);
+		}
+		/* netrun-pergb: poll() reports the socket writable on a FAILED
+		   connect too (POLLOUT|POLLERR for an RST / unreachable host), so
+		   stock 3proxy answers "200 Connection established" / a SOCKS
+		   success for a dead upstream. Check SO_ERROR and fail the connect
+		   (13) when it did not actually succeed. */
+		{
+			int so_err = 0;
+			SASIZETYPE so_errlen = sizeof(so_err);
+			if(so._getsockopt(sock, SOL_SOCKET, SO_ERROR, (char *)&so_err, &so_errlen) || so_err) {
+				return (13);
+			}
 		}
 		return 0;
 }
@@ -443,11 +455,56 @@
 			param->sinsl = param->srv->extsa;
 	}
 	*SAPORT(&param->sinsl) = 0;
+#ifdef __linux__
+#ifndef IP_BIND_ADDRESS_NO_PORT
+#define IP_BIND_ADDRESS_NO_PORT 24
+#endif
+	/* netrun-pergb: defer the source port to connect(), so sockets bound to
+	   one source address but connecting to different destinations share
+	   source ports (no ephemeral port exhaustion of the egress IPv4). */
+	if(param->operation >= 256 || (param->operation & CONNECT)){
+		int opt = 1;
+		so._setsockopt(param->remsock, IPPROTO_IP, IP_BIND_ADDRESS_NO_PORT, (char *)&opt, sizeof(opt));
+	}
+#endif
 	if(so._bind(param->remsock, (struct sockaddr*)&param->sinsl, SASIZE(&param->sinsl))==-1) {
 		return 12;
 	}
 	
 	if(param->operation >= 256 || (param->operation & CONNECT)){
+		/* netrun-pergb #4: per-client OS fingerprint from the login's
+		   -os-<profile>. Windows advertises hop limit 128 (the main p0f
+		   tell); macOS and Linux keep 64, so only Windows is rewritten
+		   here. Set on the outbound socket before connect so the SYN
+		   carries it; no privilege needed. The TCP window / scale / option
+		   part of the fingerprint is done by the tc-bpf egress program. */
+		if(param->username){
+			/* netrun-pergb #4 v2: per-client OS fingerprint. Mark the
+			   outbound socket with FNV-1a(name) from the login's
+			   -os-<name>; the egress helper (deploy/node/osfp) maps the
+			   mark to a p0f signature and rewrites the SYN (ttl, window,
+			   scale, options). SO_MARK needs CAP_NET_ADMIN; without it the
+			   setsockopt fails harmlessly (no spoof). Must match the FNV in
+			   osfp_rewrite.py / the orchestrator byte for byte. */
+			char *osn = strstr((char *)param->username, "-os-");
+			if(osn){
+				unsigned int h = 2166136261u;
+				int n = 0;
+				osn += 4;
+				while(osn[n] && osn[n] != '-' && n < 32){
+					unsigned char c = (unsigned char)osn[n];
+					if(c >= 'A' && c <= 'Z') c = (unsigned char)(c + 32);
+					h = (h ^ c) * 16777619u;
+					n++;
+				}
+				if(n > 0){
+					int mark = (int)(0x10000000u | (h & 0x0FFFFFFFu));
+#ifdef SO_MARK
+					so._setsockopt(param->remsock, SOL_SOCKET, SO_MARK, (char *)&mark, sizeof(mark));
+#endif
+				}
+			}
+		}
 		if(connectwithpoll(param->remsock,(struct sockaddr *)&param->sinsr,SASIZE(&param->sinsr),CONNECT_TO)) {
 			return 13;
 		}
diff -ru a/src/conf.c b/src/conf.c
--- a/src/conf.c
+++ b/src/conf.c
@@ -1356,6 +1356,10 @@
 #endif
 static int h_authcache(int argc, unsigned char **argv){
 	conf.authcachetype = 0;
+	/* netrun-pergb: `authcache none` switches the cache off (type 0), so
+	   doauth() never inserts an entry. Upstream turns 0 into 6 below, and
+	   every type leaks one entry per distinct login (or per connection). */
+	if(!strcmp((char *) *(argv + 1), "none")) return 0;
