# NETRUN per-GB OS-fingerprint: send only our own marked, pure SYNs to the
# rewriter queue, with `bypass` (no daemon -> unmodified). 3proxy (patched)
# sets meta mark 0x1xxxxxxx = FNV-1a(profile name) from -os-<name> via SO_MARK;
# the daemon maps the mark to a p0f signature. Scope: egress, TCP SYN (not
# SYN-ACK), our mark prefix 0x10000000 only.
table inet netrun_osfp {
    chain egress {
        type filter hook output priority 0; policy accept;
        meta mark & 0xf0000000 != 0x10000000 return
        meta l4proto tcp tcp flags & (syn|ack) == syn queue num 0 bypass
    }
}
